{
  "name": "dsh-plugin-jyn",
  "version": "0.1.0",
  "description": "Just You Need - Background configuration optimizer for dsh",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@jyn/core": "workspace:*",
    "cordis": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "dsh": {
    "bundle": {
      "path": "./dist/index.js"
    }
  }
}
